{
  "name": "plainlang",
  "version": "0.4.0",
  "description": "Plain - a programming language you write like a normal sentence, with 2D and 3D game engines, a website designer and a video editor.",
  "type": "module",
  "bin": {
    "plain": "bin/plain.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./game": "./engines/game/engine.js",
    "./web": "./engines/web/engine.js",
    "./world": "./engines/world/engine.js",
    "./video": "./engines/video/engine.js",
    "./store": "./engines/store/engine.js",
    "./translate": "./src/translate/index.js"
  },
  "scripts": {
    "test": "node tests/run-tests.js",
    "hello": "node bin/plain.js run examples/hello.plain",
    "learn": "node bin/plain.js learn",
    "prepublishOnly": "node tests/run-tests.js"
  },
  "files": [
    "bin",
    "src",
    "engines",
    "examples",
    "LANGUAGE.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "programming-language",
    "beginner",
    "learn-to-code",
    "game-engine",
    "3d",
    "webgl",
    "website-builder",
    "video-editor",
    "transpiler",
    "interpreter",
    "no-dependencies"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetDial/plain-lang.git"
  },
  "bugs": {
    "url": "https://github.com/JetDial/plain-lang/issues"
  },
  "homepage": "https://github.com/JetDial/plain-lang#readme"
}
