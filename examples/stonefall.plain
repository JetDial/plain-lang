# STONEFALL - the flagship game, using everything the engine has.
#
#     plain play examples/stonefall.plain
#
# A walled stone garden at low sun. Seven relics lie among the ruins; three
# wardens walk their rounds. Take every relic and reach the gate before your
# three hearts are gone.
#
# One file, no tools, nothing imported. Textured ground and walls, shadows
# cast by the sun, a lamp burning at the gate, haze over the far wall, a
# third person camera, patrol clocks, a title scene, a win and a loss.
#
# Arrows walk and turn. Space jumps. Hold Z to sprint.

start a world called "Stonefall" sized 1000 by 640
set the sky to "#dfb98c"
set the light to 0.55 , 0.7 , 0.35
set the light colour to "#ffe2b0"
set the haze to 0.5
set world gravity to 0.03
let the sun cast shadows

# ------------------------------------------------------------ the garden

make ground be a floor at 0 , 0 , 0 sized 64 by 64 colored "#b6c98f"
cover ground with the picture "pictures/grass.png" repeated 24 times

# The wall around everything, stone on all four sides.
make northwall be a block at 0 , 2 , -30 sized 62 by 4 by 2 colored "#d8d8d8"
make southwall be a block at 0 , 2 , 30 sized 62 by 4 by 2 colored "#d8d8d8"
make eastwall be a block at 30 , 2 , 0 sized 2 by 4 by 58 colored "#d8d8d8"
make westwall be a block at -30 , 2 , 0 sized 2 by 4 by 58 colored "#d8d8d8"
cover northwall with the picture "pictures/stone.png" repeated 12 times
cover southwall with the picture "pictures/stone.png" repeated 12 times
cover eastwall with the picture "pictures/stone.png" repeated 12 times
cover westwall with the picture "pictures/stone.png" repeated 12 times

# Ruins to hide behind - their shadows are half the game.
make ruin1 be a block at -12 , 2 , -8 sized 8 by 4 by 2 colored "#e0dccc"
make ruin2 be a block at 10 , 1.5 , 6 sized 2 by 3 by 10 colored "#e0dccc"
make ruin3 be a block at 4 , 2.5 , -16 sized 6 by 5 by 2 colored "#e0dccc"
make ruin4 be a block at -16 , 1 , 14 sized 10 by 2 by 2 colored "#e0dccc"
cover ruin1 with the picture "pictures/stone.png" repeated 4 times
cover ruin2 with the picture "pictures/stone.png" repeated 4 times
cover ruin3 with the picture "pictures/stone.png" repeated 4 times
cover ruin4 with the picture "pictures/stone.png" repeated 4 times

make post1 be a post at -6 , 2 , 10 sized 1 by 4 colored "#e8e4d4"
make post2 be a post at 16 , 2 , -12 sized 1 by 4 colored "#e8e4d4"
cover post1 with the picture "pictures/stone.png" repeated 3 times
cover post2 with the picture "pictures/stone.png" repeated 3 times

# The gate: two wooden pillars in the south wall, and a lamp burning there
# so you can find your way home late in the game.
make gateleft be a block at -3 , 2 , 29 sized 1 by 4 by 1 colored "#caa06a"
make gateright be a block at 3 , 2 , 29 sized 1 by 4 by 1 colored "#caa06a"
cover gateleft with the picture "pictures/wood.png" repeated 2 times
cover gateright with the picture "pictures/wood.png" repeated 2 times
put a lamp at 0 , 3 , 27 reaching 12 colored "#ffb347"

# ------------------------------------------------------------ the people

make hero be a cube at 0 , 1 , 24 sized 1.2 colored "#ffd166"
cover hero with the picture "pictures/wood.png"
follow hero with the camera
set the camera distance to 9
set the camera height to 4.4

# Three wardens, each walking a rectangle of its own. A patrol is a clock:
# the warden's place is where the clock says it should be, so it can never
# drift, stick, or be pushed out of its round.
make wardens be [
    { name: "north", cx: -8, cz: -18, wide: 16, deep: 6, lap: 620, beat: 0 },
    { name: "east", cx: 14, cz: -2, wide: 8, deep: 20, lap: 700, beat: 350 },
    { name: "gate", cx: 0, cz: 14, wide: 20, deep: 8, lap: 760, beat: 100 }
]
make warden1 be a cube at 0 , 1 , 0 sized 1.4 colored "#b03535"
make warden2 be a cube at 0 , 1 , 0 sized 1.4 colored "#b03535"
make warden3 be a cube at 0 , 1 , 0 sized 1.4 colored "#b03535"
cover warden1 with the picture "pictures/stone.png"
cover warden2 with the picture "pictures/stone.png"
cover warden3 with the picture "pictures/stone.png"
make guards be [warden1, warden2, warden3]

# Where along its rectangle a warden's clock puts it.
to placeof with plan and tick
    make wide be wide of plan
    make deep be deep of plan
    make edge be (wide plus deep) times 2
    make along be tick modulo edge
    if along is below wide
        give back { x: (cx of plan) minus (wide divided by 2) plus along, z: (cz of plan) minus (deep divided by 2) }
    end
    set along to along minus wide
    if along is below deep
        give back { x: (cx of plan) plus (wide divided by 2), z: (cz of plan) minus (deep divided by 2) plus along }
    end
    set along to along minus deep
    if along is below wide
        give back { x: (cx of plan) plus (wide divided by 2) minus along, z: (cz of plan) plus (deep divided by 2) }
    end
    set along to along minus wide
    give back { x: (cx of plan) minus (wide divided by 2), z: (cz of plan) plus (deep divided by 2) minus along }
end

# ------------------------------------------------------------ the relics

make spots be [
    { x: -12, z: -12 }, { x: 14, z: -18 }, { x: -22, z: 4 },
    { x: 22, z: 12 }, { x: 4, z: -22 }, { x: -8, z: 20 }, { x: 18, z: -2 }
]
make relic1 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relic2 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relic3 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relic4 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relic5 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relic6 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relic7 be a ball at 0 , 1.1 , 0 sized 0.9 colored "#38d9d9"
make relics be [relic1, relic2, relic3, relic4, relic5, relic6, relic7]
repeat with n from 1 to 7
    make spot be item n of spots
    move item n of relics to x of spot , 1.1 , z of spot
end

# ------------------------------------------------------------ the game

make state be "front"
make hearts be 3
make taken be 0
make hurt be 0
make clock be 0
make breath be 100

to hitby with guard
    if hurt is at most 0
        take 1 from hearts
        set hurt to 50
        shake the view
        play a thud
        # Knocked back towards the gate, away from the warden.
        make away be x of hero minus x of guard
        make awayz be z of hero minus z of guard
        move hero by away times 2 , 0.4 , awayz times 2
        if hearts is at most 0
            set state to "lost"
        end
    end
end

every frame
    add 1 to clock

    # Wardens walk their rounds whatever else is happening: the garden
    # does not care who is watching it.
    repeat with n from 1 to 3
        make plan be item n of wardens
        set value "beat" of plan to (beat of plan) plus 1
        make edge be ((wide of plan) plus (deep of plan)) times 2
        make tick be ((beat of plan) modulo (lap of plan)) times edge divided by (lap of plan)
        make spot be placeof with plan and tick
        make guard be item n of guards
        move guard to x of spot , 1 , z of spot
        turn guard left by 2
    end

    # The relics idle where they lie, waiting to be noticed.
    repeat with n from 1 to 7
        turn item n of relics left by 3
    end

    if state is "front"
        draw "STONEFALL" centred at 500 , 200 sized 44 colored "#3a2c18"
        draw "seven relics lie in the garden - the wardens would rather they stayed" centred at 500 , 260 sized 15 colored "#6b5637"
        draw "arrows walk and turn - space jumps - hold Z to sprint" centred at 500 , 300 sized 14 colored "#6b5637"
        draw "take all seven, then reach the lamp at the gate" centred at 500 , 330 sized 14 colored "#6b5637"
        draw "press ENTER" centred at 500 , 400 sized 18 colored "#a03a2a"
    end

    if state is "playing"
        # Sprinting spends breath; walking earns it back. A chase you can
        # not win forever is what makes the wardens matter.
        make pace be 0.16
        if key "z" is held and breath is above 0
            set pace to 0.3
            take 2 from breath
        otherwise
            if breath is below 100
                add 1 to breath
            end
        end

        if key "left" is held
            turn hero left by 3
        end
        if key "right" is held
            turn hero right by 3
        end
        if key "up" is held
            move hero forward by pace
        end
        if key "down" is held
            move hero back by 0.1
        end

        if hurt is above 0
            take 1 from hurt
        end

        # The top of the screen: hearts, relics, breath.
        make marks be ""
        repeat hearts times
            set marks to "{marks}#"
        end
        draw "hearts {marks}" at 20 , 18 sized 15 colored "#a03a2a"
        draw "relics {taken} of 7" at 20 , 44 sized 15 colored "#1d6d6d"
        draw "breath {round breath}" at 20 , 70 sized 13 colored "#5a6b3a"
        if taken is 7
            draw "the gate is open - the lamp is lit for you" centred at 500 , 30 sized 15 colored "#a05f1e"
        end
    end

    if state is "won"
        draw "THE GARDEN FORGIVES YOU" centred at 500 , 240 sized 32 colored "#1d6d6d"
        draw "seven relics, {hearts} hearts to spare" centred at 500 , 300 sized 16 colored "#3a2c18"
        draw "press ENTER to walk in again" centred at 500 , 360 sized 14 colored "#6b5637"
    end
    if state is "lost"
        draw "THE WARDENS KEEP THEIR GARDEN" centred at 500 , 240 sized 32 colored "#7a2020"
        draw "you fell {7 minus taken} relics short" centred at 500 , 300 sized 16 colored "#3a2c18"
        draw "press ENTER to try once more" centred at 500 , 360 sized 14 colored "#6b5637"
    end
end

when key "space" is pressed
    if state is "playing" and hero is resting
        push hero up by 0.42
        play a blip at 520
    end
end

when key "enter" is pressed
    if state is not "playing"
        set state to "playing"
        set hearts to 3
        set taken to 0
        set breath to 100
        move hero to 0 , 1 , 24
        repeat with n from 1 to 7
            make spot be item n of spots
            make relic be item n of relics
            move relic to x of spot , 1.1 , z of spot
            reveal relic
        end
        play a beep at 660
    end
end

when hero touches warden1
    if state is "playing"
        hitby with warden1
    end
end
when hero touches warden2
    if state is "playing"
        hitby with warden2
    end
end
when hero touches warden3
    if state is "playing"
        hitby with warden3
    end
end

to grab with relic
    if state is "playing"
        hide relic
        add 1 to taken
        play a beep at 880
        if taken is 7
            play a beep at 1320
        end
    end
end

when hero touches relic1
    grab with relic1
end
when hero touches relic2
    grab with relic2
end
when hero touches relic3
    grab with relic3
end
when hero touches relic4
    grab with relic4
end
when hero touches relic5
    grab with relic5
end
when hero touches relic6
    grab with relic6
end
when hero touches relic7
    grab with relic7
end

# Home: the space between the gate pillars, once every relic is in hand.
when hero touches gateleft
    if state is "playing" and taken is 7
        set state to "won"
    end
end
when hero touches gateright
    if state is "playing" and taken is 7
        set state to "won"
    end
end
