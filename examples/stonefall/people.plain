# The hero, the camera on their shoulder, and three wardens walking
# clockwork rounds.

make hero be a cube at 0 , 1 , 24 sized 1.2 colored "#ffd166"
cover hero with the picture "pictures/wood.png"
follow hero with the camera
set the camera distance to 9
set the camera height to 4.4

# Three wardens, each walking a rectangle of its own. A patrol is a clock:
# the warden's place is where the clock says it should be, so it can never
# drift, stick, or be pushed out of its round.
make wardens be [
    { name: "north", cx: -8, cz: -18, wide: 16, deep: 6, lap: 620, beat: 0 },
    { name: "east", cx: 14, cz: -2, wide: 8, deep: 20, lap: 700, beat: 350 },
    { name: "gate", cx: 0, cz: 14, wide: 20, deep: 8, lap: 760, beat: 100 }
]
make warden1 be a cube at 0 , 1 , 0 sized 1.4 colored "#b03535"
make warden2 be a cube at 0 , 1 , 0 sized 1.4 colored "#b03535"
make warden3 be a cube at 0 , 1 , 0 sized 1.4 colored "#b03535"
cover warden1 with the picture "pictures/stone.png"
cover warden2 with the picture "pictures/stone.png"
cover warden3 with the picture "pictures/stone.png"
make guards be [warden1, warden2, warden3]

# Where along its rectangle a warden's clock puts it.
to placeof with plan and tick
    make wide be wide of plan
    make deep be deep of plan
    make edge be (wide plus deep) times 2
    make along be tick modulo edge
    if along is below wide
        give back { x: (cx of plan) minus (wide divided by 2) plus along, z: (cz of plan) minus (deep divided by 2) }
    end
    set along to along minus wide
    if along is below deep
        give back { x: (cx of plan) plus (wide divided by 2), z: (cz of plan) minus (deep divided by 2) plus along }
    end
    set along to along minus deep
    if along is below wide
        give back { x: (cx of plan) plus (wide divided by 2) minus along, z: (cz of plan) plus (deep divided by 2) }
    end
    set along to along minus wide
    give back { x: (cx of plan) minus (wide divided by 2), z: (cz of plan) plus (deep divided by 2) minus along }
end
